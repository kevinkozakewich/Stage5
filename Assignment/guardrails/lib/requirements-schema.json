{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://improving.local/level-4/requirements.schema.json",
  "title": "DownstreamMigrationTriggerRequirements",
  "type": "object",
  "additionalProperties": true,
  "required": ["table", "pk", "trigger_type"],
  "properties": {
    "table": {
      "type": "string",
      "minLength": 1,
      "description": "Fully qualified or schema-qualified DMO table name"
    },
    "pk": {
      "description": "Primary key column name(s)",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "trigger_type": {
      "type": "string",
      "enum": ["AFTER INSERT", "AFTER UPDATE", "AFTER DELETE", "AFTER INSERT, UPDATE, DELETE"],
      "description": "Trigger firing events"
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
